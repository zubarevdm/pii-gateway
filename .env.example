# Скопируйте в .env и заполните под себя.

# Куда форвардить ОБЕЗЛИЧЕННЫЙ запрос (OpenAI-совместимый endpoint).
UPSTREAM_BASE_URL=https://api.openai.com/v1
# Ключ доступа клиента к его модели. Можно оставить пустым и пробрасывать
# Authorization из запроса клиента.
UPSTREAM_API_KEY=

# Адрес локального шлюза.
HOST=127.0.0.1
PORT=8787

# Слой контекстного NER (ФИО/организации/адреса). false = только regex (быстрее).
ENABLE_NER=true
NER_CONFIDENCE=0.85

# Аудит обезличивания (факт+тип, без ПД).
AUDIT_ENABLED=true
AUDIT_PATH=./audit.log
